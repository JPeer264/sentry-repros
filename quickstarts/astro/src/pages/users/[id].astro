---
// Repro-only parameterized, server-rendered route (no view transitions router).
import Base from "../../layouts/Base.astro";
const { id } = Astro.params;
---

<Base title={`user ${id}`}>
  <h1>User <span id="user-id">{id}</span></h1>
  <a id="nav-next" href={`/users/${Number(id) + 1}`}>next user</a>
  <a id="nav-home" href="/">home</a>
</Base>
