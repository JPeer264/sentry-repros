{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "strict": false,
    "outDir": "dist-esm",
    "rootDir": "src",
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
