{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "qs-angular": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/variants/base/main.ts",
            "tsConfig": "src/variants/base/tsconfig.json",
            "index": "src/index.html",
            "outputPath": { "base": "dist/base", "browser": "" },
            "polyfills": [],
            "styles": [],
            "assets": [],
            "sourceMap": false,
            "outputHashing": "none",
            "extractLicenses": false,
            "namedChunks": false,
            "budgets": []
          },
          "configurations": {
            "production": {
              "optimization": true,
              "sourceMap": false
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            },
            "base": {
              "browser": "src/variants/base/main.ts",
              "tsConfig": "src/variants/base/tsconfig.json",
              "outputPath": { "base": "dist/base", "browser": "" }
            },
            "app-config-verbatim": {
              "browser": "src/variants/app-config-verbatim/main.ts",
              "tsConfig": "src/variants/app-config-verbatim/tsconfig.json",
              "outputPath": { "base": "dist/app-config-verbatim", "browser": "" }
            },
            "app-initializer": {
              "browser": "src/variants/app-initializer/main.ts",
              "tsConfig": "src/variants/app-initializer/tsconfig.json",
              "outputPath": { "base": "dist/app-initializer", "browser": "" }
            },
            "ngmodule": {
              "browser": "src/variants/ngmodule/main.ts",
              "tsConfig": "src/variants/ngmodule/tsconfig.json",
              "index": { "input": "src/index-ngmodule.html", "output": "index.html" },
              "polyfills": ["zone.js"],
              "outputPath": { "base": "dist/ngmodule", "browser": "" }
            },
            "error-handler-custom": {
              "browser": "src/variants/error-handler-custom/main.ts",
              "tsConfig": "src/variants/error-handler-custom/tsconfig.json",
              "outputPath": { "base": "dist/error-handler-custom", "browser": "" }
            },
            "error-handler-custom-fixed": {
              "browser": "src/variants/error-handler-custom-fixed/main.ts",
              "tsConfig": "src/variants/error-handler-custom-fixed/tsconfig.json",
              "outputPath": { "base": "dist/error-handler-custom-fixed", "browser": "" }
            },
            "error-handler-options": {
              "browser": "src/variants/error-handler-options/main.ts",
              "tsConfig": "src/variants/error-handler-options/tsconfig.json",
              "outputPath": { "base": "dist/error-handler-options", "browser": "" }
            },
            "component-tracking": {
              "browser": "src/variants/component-tracking/main.ts",
              "tsConfig": "src/variants/component-tracking/tsconfig.json",
              "outputPath": { "base": "dist/component-tracking", "browser": "" }
            },
            "component-tracking-verbatim": {
              "browser": "src/variants/component-tracking-verbatim/main.ts",
              "tsConfig": "src/variants/component-tracking-verbatim/tsconfig.json",
              "outputPath": { "base": "dist/component-tracking-verbatim", "browser": "" }
            }
          },
          "defaultConfiguration": "production"
        }
      }
    }
  }
}
