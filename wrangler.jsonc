{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sentry-cloudflare-waituntil-repro",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "durable_objects": {
    "bindings": [{ "name": "REPRO_DO", "class_name": "ReproDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReproDO"] }]
}
