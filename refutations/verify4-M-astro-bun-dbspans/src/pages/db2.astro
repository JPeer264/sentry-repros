---
import mysql2 from 'mysql2';
export const prerender = false;
const connection = mysql2.createConnection({ host: '127.0.0.1', port: 3307, user: 'root', database: 'app' });
const rows = await new Promise((resolve, reject) => {
  connection.query('SELECT id, name FROM users WHERE id > 0', (err, res) => {
    connection.end();
    err ? reject(err) : resolve(res);
  });
});
---
<html><body><h1>db2 {JSON.stringify(rows)}</h1></body></html>
