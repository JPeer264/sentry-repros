import dc from 'node:diagnostics_channel';
import * as Sentry from '@sentry/sveltekit';

Sentry.init({
  dsn: 'https://abc@o1.ingest.sentry.io/1',
  tracesSampleRate: 1.0,
  tunnel: process.env.SENTRY_TUNNEL,
  debug: true,
});

// Bun drops diagnostics-channel subscribers once the channel object is GC'd.
(globalThis as unknown as { __pinnedChannels?: unknown[] }).__pinnedChannels = [
  'mysql2:query',
  'mysql2:execute',
  'mysql2:connect',
  'mysql2:pool:connect',
].map(name => dc.tracingChannel(name));
