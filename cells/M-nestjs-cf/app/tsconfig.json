{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "strict": false,
    "outDir": "build",
    "rootDir": "src",
    "types": []
  },
  "include": ["src/**/*.ts"]
}
