{
  "name": "c26",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SENTRY_DSN": "https://public@o1.ingest.sentry.io/1",
    "SENTRY_TUNNEL": "http://127.0.0.1:41726/"
  },
  "workflows": [
    {
      "name": "c26-probe",
      "binding": "PROBE",
      "class_name": "ProbeWorkflow"
    },
    {
      "name": "c26-plain",
      "binding": "PLAIN",
      "class_name": "PlainWorkflow"
    }
  ]
}
