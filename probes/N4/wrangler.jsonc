{
  "name": "n4-agents",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SINK_URL": "http://127.0.0.1:47211/"
  },
  "durable_objects": {
    "bindings": [
      { "name": "MyAgent", "class_name": "MyAgent" },
      { "name": "LegacyAgent", "class_name": "LegacyAgent" },
      { "name": "MyChatAgent", "class_name": "MyChatAgent" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MyAgent", "LegacyAgent", "MyChatAgent"]
    }
  ]
}
