{
  "name": "probe-c07",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "SENTRY_TUNNEL": "http://127.0.0.1:51703/", "TRACE_LIFECYCLE": "stream" },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "probe" }],
  "kv_namespaces": [{ "binding": "KV", "id": "probe" }]
}
