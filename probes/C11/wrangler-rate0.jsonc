{
  "name": "c11",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "SENTRY_DSN": "https://public@o1.ingest.sentry.io/1",
    "SENTRY_ENVIRONMENT": "qa",
    "SENTRY_RELEASE": "r1",
    "SENTRY_TRACES_SAMPLE_RATE": "0"
  }
}
